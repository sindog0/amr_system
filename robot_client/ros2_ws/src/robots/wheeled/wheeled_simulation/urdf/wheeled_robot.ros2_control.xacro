<?xml version="1.0"?>
<!--
  ros2_control 接线说明：

  1. <ros2_control> 告诉 ros2_control 有哪些「硬件接口」：
     - command_interface: 控制器往硬件写的量（这里每个轮子一个 velocity）
     - state_interface:   硬件反馈给控制器的量（position/velocity）
     这些名字必须和 URDF 里 <joint> 的 name 完全一致。

  2. <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
     表示这组接口由 Gazebo 里的插件实现（真机时换成自己的 hardware_interface 插件）。

  3. <gazebo><plugin filename="gz_ros2_control-system"> 是在 Gazebo 进程里
     起一个 controller_manager 节点（ROS 里名字是 /controller_manager），
     并读取下面的 controllers.yaml 决定加载哪些控制器。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="WheeledSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <xacro:macro name="wheel_joint" params="name">
      <joint name="${name}">
        <command_interface name="velocity">
          <param name="min">-20.0</param>
          <param name="max">20.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <xacro:wheel_joint name="joint_left_w"/>
    <xacro:wheel_joint name="joint_left_s"/>
    <xacro:wheel_joint name="joint_right_w"/>
    <xacro:wheel_joint name="joint_right_s"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find wheeled_simulation)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
